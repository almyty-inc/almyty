    "date-fns": "^4.4.0",
    "lucide-react": "^1.68.0",
    "posthog-js": "^1.445.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "simple-icons": "16.36.0",
    "tailwind-merge": "^3.7.0",
