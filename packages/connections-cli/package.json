{
  "name": "@almyty/connections",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Connect third-party accounts to almyty from your terminal: list connectors, connect by API key or OAuth, validate, rotate, disconnect, grant.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "almyty-connections": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "almyty",
    "connections",
    "cli"
  ],
  "author": "almyty",
  "license": "Apache-2.0",
  "dependencies": {
    "@almyty/client": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  },
  "homepage": "https://almyty.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almyty-inc/almyty.git",
    "directory": "packages/connections-cli"
  },
  "bugs": {
    "url": "https://github.com/almyty-inc/almyty/issues"
  }
}
