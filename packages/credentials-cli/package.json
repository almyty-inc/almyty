{
  "name": "@almyty/credentials",
  "version": "1.5.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Keys, tokens and accounts for almyty from your terminal: list services, add by key or sign-in, check, replace, delete, share.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "almyty-credentials": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "almyty",
    "credentials",
    "cli"
  ],
  "author": "almyty",
  "license": "Apache-2.0",
  "dependencies": {
    "@almyty/client": "^1.5.1"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  },
  "homepage": "https://almyty.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almyty-inc/almyty.git",
    "directory": "packages/credentials-cli"
  },
  "bugs": {
    "url": "https://github.com/almyty-inc/almyty/issues"
  }
}
