{
  "name": "@almyty/mcp-server",
  "version": "1.5.7",
  "publishConfig": {
    "access": "public"
  },
  "description": "Serve any almyty gateway to Claude Code or any MCP client — turn your APIs into MCP tools with a single command.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "almyty-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-tools",
    "api-gateway",
    "openapi",
    "graphql",
    "almyty",
    "claude",
    "cursor",
    "copilot",
    "codex"
  ],
  "author": "almyty",
  "license": "Apache-2.0",
  "dependencies": {
    "@almyty/client": "^1.5.7",
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.4.0"
  },
  "homepage": "https://almyty.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almyty-inc/almyty.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/almyty-inc/almyty/issues"
  }
}
