# Never commit license signing keys (forgeable entitlements)
backend/scripts/license/*.pem

# Claude DesignSync working dir (generated tooling + deps; regenerated on demand, not app source)
.ds-sync/
# Only the cache. The rest of .design-sync/ is hand-written and worth
# keeping: the sync notes, the config, and the preview compositions the
# design system is reviewed against. The cache carries its own ignore.
.design-sync/.cache/

# Compiled design-system bundle, produced by design-sync-cli from the
# two directories above. Nothing in the repo builds or ships from it,
# and it is 8 MB of screenshots and vendored JS that is regenerated on
# demand.
/ds-bundle/

# Local object storage (STORAGE_TYPE=local). Holds uploaded files and
# built app artifacts, which are large and regenerated on demand.
backend/uploads/

# Per-agent skill installs. The content lives in .agents/ (ignored above);
# these are symlink farms one CLI or another expects at its own path, and
# committing them puts dangling links and a record of which vendors'
# tooling is installed into a public repo.
.crush/
.hermes/
.vibe/
/skills/
skills-lock.json
