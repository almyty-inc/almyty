# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/almyty
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=almyty

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# Cross-pod stream backlogs (Redis): worker-stream Last-Event-ID replay and
# the coding relay's per-session event backlog
WORKER_STREAM_REPLAY_MAX=256
WORKER_STREAM_REPLAY_TTL_S=600
CODING_RELAY_BACKLOG_MAXLEN=2000
CODING_RELAY_BACKLOG_TTL_S=86400

# Hosted runners (docs/hosted-runners.md): off unless true. The cluster is a
# kubernetes connection, <organizationId>/<connectionId>; every number is in
# the settings JSON (a file and/or inline), merged over the shipped defaults.
HOSTED_RUNNERS_ENABLED=false
# HOSTED_RUNNERS_CLUSTER_CONNECTION=<organizationId>/<connectionId>
# HOSTED_RUNNERS_PROVIDER=kubernetes
# HOSTED_RUNNERS_SETTINGS_FILE=/etc/almyty/hosted-runners.json
# HOSTED_RUNNERS_SETTINGS={"idleTimeoutMinutes":{"default":15}}

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# API Keys for LLM Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# CORS Configuration
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
# RATE_LIMIT_MAX requests per RATE_LIMIT_TTL seconds, counted per client
# address. Routes with their own tighter limit (login, register, ...) keep it.
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
# Gateway traffic (MCP, UTCP, A2A, channel webhooks) has its own per-client
# limit on the unified endpoint, on top of each gateway's configured limits.
# UNIFIED_ENDPOINT_RATE_LIMIT=60
# UNIFIED_ENDPOINT_RATE_TTL_SECONDS=60

# MCP (backend/src/modules/mcp/core/mcp-settings.ts). All optional.
# Protocol versions answered, newest first by default:
# MCP_PROTOCOL_VERSIONS=2026-07-28,2025-11-25,2025-06-18,2025-03-26,2024-11-05
# Extra browser origins allowed to call MCP endpoints (the dashboard and the
# API's own origin always are):
# MCP_ALLOWED_ORIGINS=
# MCP_TOOLS_LIST_CACHE_SECONDS=60
# MCP_EMIT_OUTPUT_SCHEMA=true
# MCP 2026-07-28: how long a client may reuse a list or read result
# (ttlMs), and the keep-alive and longest life of a subscriptions/listen
# stream (the client reconnects after it ends):
# MCP_RESULT_TTL_MS=60000
# MCP_LISTEN_KEEPALIVE_MS=15000
# MCP_LISTEN_MAX_SECONDS=3600
# MCP 2026-07-28 agent runs and approvals: how often a client polls a run
# followed as a task, how long invoke_agent waits for a run before answering
# with its id (0 = never wait), how long a just-approved held call is waited
# for, and how long an input_required requestState stays valid:
# MCP_TASK_POLL_INTERVAL_MS=2000
# MCP_INVOKE_WAIT_MS=25000
# MCP_HELD_CALL_WAIT_MS=5000
# MCP_REQUEST_STATE_TTL_SECONDS=900
# Client ID Metadata Documents (OAuth clients named by an https URL):
# MCP_CIMD_ENABLED=true
# MCP_CIMD_FETCH_TIMEOUT_MS=5000
# MCP_CIMD_MAX_BYTES=65536
# MCP_CIMD_CACHE_MIN_SECONDS=300
# MCP_CIMD_CACHE_MAX_SECONDS=86400
# MCP_CIMD_FETCHES_PER_HOST=30
# MCP_CIMD_FETCH_WINDOW_SECONDS=60
# A registration without application_type whose redirect URIs are all
# loopback is taken as a native app (most MCP CLIs and desktop apps):
# MCP_OAUTH_INFER_APPLICATION_TYPE=true
# The legacy HTTP+SSE routes (/mcp/sse, deprecated in MCP 2026-07-28) answer
# with RFC 9745 Deprecation and Link headers:
# MCP_LEGACY_SSE_DEPRECATION_HEADERS=true
# MCP_LEGACY_SSE_DEPRECATED_AT=2026-07-28
# MCP_LEGACY_SSE_DOCS_URL=https://docs.almyty.com/gateways/mcp#legacy-sse-transport
# MCP client: almyty connecting to outside MCP servers (MCP sources and the
# "MCP server" connection check; mcp-sources/mcp-client-settings.ts).
# auto tries MCP 2026-07-28 first and falls back to initialize; modern or
# legacy pins one era for every server:
# MCP_CLIENT_ERA=auto
# MCP_CLIENT_TIMEOUT_MS=30000
# MCP_CLIENT_MAX_TOOL_PAGES=50
# A remote task followed within one tool call, then cancelled:
# MCP_CLIENT_TASK_DEADLINE_MS=600000
# MCP_CLIENT_TASK_POLL_MIN_MS=500
# MCP_CLIENT_TASK_POLL_MAX_MS=30000
# input_required rounds answered without a person (roots) per call:
# MCP_CLIENT_INPUT_ROUNDS=3
# How long a remote's question inside an agent run waits for the answer:
# MCP_CLIENT_PENDING_INPUT_SECONDS=3600
# How often a call for an agent run checks whether the run was cancelled
# (a remote task is then cancelled too):
# MCP_CLIENT_RUN_CANCEL_CHECK_MS=2000
# Signing in to OAuth-protected MCP servers from Credentials
# (backend/src/modules/connections/mcp-oauth). All optional.
# MCP_CLIENT_OAUTH_FETCH_TIMEOUT_MS=10000
# MCP_CLIENT_OAUTH_MAX_BYTES=65536
# MCP_CLIENT_OAUTH_REFRESH_SKEW_SECONDS=60
# The almyty client metadata document at /credentials/oauth/client-metadata.json
# (used as client id where a server accepts one; needs the API on https):
# MCP_CLIENT_CIMD_ENABLED=true
# MCP_CLIENT_CIMD_MAX_AGE_SECONDS=3600
# MCP_CLIENT_NAME=almyty
# Tool discovery (search_tools, get_tool; modules/tool-discovery). Results
# per search by default and at most, the rank-fusion constant, how many
# nearest tools the meaning half ranks, and whether tools are embedded at all
# (off: search ranks by keywords alone). TOOL_SCOPE_MAX_TOOLS caps how many
# tools one scope (a member's whole view of the organization) is read as.
# TOOL_SEARCH_DEFAULT_LIMIT=10
# TOOL_SEARCH_MAX_LIMIT=50
# TOOL_SEARCH_RRF_K=60
# TOOL_SEARCH_VECTOR_CANDIDATES=100
# TOOL_EMBEDDINGS_ENABLED=true
# TOOL_SCOPE_MAX_TOOLS=5000
# Tool mode of autonomous agents (agents/agent-tool-mode.ts): the mode an
# agent that sets none gets (direct, discover or auto), and the auto
# threshold, as a percentage of the main model's context window or, without a
# model card, in tokens. An agent's own threshold replaces both.
# AGENT_TOOL_MODE_DEFAULT=auto
# AGENT_TOOL_MODE_THRESHOLD_PERCENT=3
# AGENT_TOOL_MODE_FALLBACK_TOKENS=4000
# Code mode (code-mode/code-mode.settings.ts): the limits of one run_code
# script. An organization may set any of them lower in settings.codeMode.
# CODE_MODE_MAX_CALLS=100
# CODE_MODE_MAX_IN_FLIGHT=4
# CODE_MODE_TIMEOUT_MS=30000
# CODE_MODE_MAX_TIMEOUT_MS=120000
# CODE_MODE_MEMORY_MB=128
# CODE_MODE_LOG_CAP=16384
# CODE_MODE_RESULT_CAP=16384
# CODE_MODE_MAX_CODE_CHARS=50000
# CPU time a gateway script may spend computing (QuickJS); waiting on tools does not count.
# CODE_MODE_CPU_MS=10000
# extract(): characters of the value sent to the model, and tokens it may answer with.
# CODE_MODE_EXTRACT_MAX_INPUT=50000
# CODE_MODE_EXTRACT_MAX_TOKENS=2000
# The scripts' own sandbox pool, apart from JavaScript tools (node-sandbox.service.ts).
# SANDBOX_CODE_MAX_WORKERS=4
# SANDBOX_CODE_MAX_WORKERS_PER_ORG=2
# SANDBOX_CODE_MAX_QUEUE_SIZE=50
# SANDBOX_CODE_MAX_QUEUE_PER_ORG=13
# Scripts on MCP, UTCP and Skills gateways (code-mode/code-exposure.ts), run in
# QuickJS (docs/design/code-mode.md, P3 gate). Off unless an install turns it on.
# CODE_MODE_GATEWAYS=false
# Gateway scripts run in QuickJS, one worker per script, in a pool of their own
# (tools/node-sandbox/quickjs-sandbox.service.ts).
# SANDBOX_QUICKJS_MAX_WORKERS=4
# SANDBOX_QUICKJS_MAX_WORKERS_PER_ORG=2
# SANDBOX_QUICKJS_MAX_QUEUE_SIZE=50
# SANDBOX_QUICKJS_MAX_QUEUE_PER_ORG=13
# How many proxies in front of the API append to X-Forwarded-For. The client
# address is read that many entries from the RIGHT of the header. 1 = a single
# ingress / reverse proxy; add one per extra proxy (CDN, L7 load balancer).
# Too high lets a client pick its own rate-limit bucket; too low merges clients.
TRUSTED_PROXY_HOPS=1

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log