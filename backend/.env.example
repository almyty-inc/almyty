# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/almyty
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=almyty

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# API Keys for LLM Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# CORS Configuration
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
# RATE_LIMIT_MAX requests per RATE_LIMIT_TTL seconds, counted per client
# address. Routes with their own tighter limit (login, register, ...) keep it.
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
# Gateway traffic (MCP, UTCP, A2A, channel webhooks) has its own per-client
# limit on the unified endpoint, on top of each gateway's configured limits.
# UNIFIED_ENDPOINT_RATE_LIMIT=60
# UNIFIED_ENDPOINT_RATE_TTL_SECONDS=60

# MCP (backend/src/modules/mcp/core/mcp-settings.ts). All optional.
# Protocol versions answered, newest first by default:
# MCP_PROTOCOL_VERSIONS=2026-07-28,2025-11-25,2025-06-18,2025-03-26,2024-11-05
# Extra browser origins allowed to call MCP endpoints (the dashboard and the
# API's own origin always are):
# MCP_ALLOWED_ORIGINS=
# MCP_TOOLS_LIST_CACHE_SECONDS=60
# MCP_EMIT_OUTPUT_SCHEMA=true
# MCP 2026-07-28: how long a client may reuse a list or read result
# (ttlMs), and the keep-alive and longest life of a subscriptions/listen
# stream (the client reconnects after it ends):
# MCP_RESULT_TTL_MS=60000
# MCP_LISTEN_KEEPALIVE_MS=15000
# MCP_LISTEN_MAX_SECONDS=3600
# Client ID Metadata Documents (OAuth clients named by an https URL):
# MCP_CIMD_ENABLED=true
# MCP_CIMD_FETCH_TIMEOUT_MS=5000
# MCP_CIMD_MAX_BYTES=65536
# MCP_CIMD_CACHE_MIN_SECONDS=300
# MCP_CIMD_CACHE_MAX_SECONDS=86400
# MCP_CIMD_FETCHES_PER_HOST=30
# MCP_CIMD_FETCH_WINDOW_SECONDS=60
# A registration without application_type whose redirect URIs are all
# loopback is taken as a native app (most MCP CLIs and desktop apps):
# MCP_OAUTH_INFER_APPLICATION_TYPE=true
# The legacy HTTP+SSE routes (/mcp/sse, deprecated in MCP 2026-07-28) answer
# with RFC 9745 Deprecation and Link headers:
# MCP_LEGACY_SSE_DEPRECATION_HEADERS=true
# MCP_LEGACY_SSE_DEPRECATED_AT=2026-07-28
# MCP_LEGACY_SSE_DOCS_URL=https://docs.almyty.com/gateways/mcp#legacy-sse-transport
# How many proxies in front of the API append to X-Forwarded-For. The client
# address is read that many entries from the RIGHT of the header. 1 = a single
# ingress / reverse proxy; add one per extra proxy (CDN, L7 load balancer).
# Too high lets a client pick its own rate-limit bucket; too low merges clients.
TRUSTED_PROXY_HOPS=1

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log